# Nexora AI Environment Variables
# Copy this file to .env and fill in your values.

SKIP_PREFLIGHT_CHECK=true

# Nexora AI (Express only — do not prefix these with REACT_APP_)
AI_PROVIDER=openai
OPENAI_KEY=
OPENAI_MODEL=gpt-4o
AI_TIMEOUT_MS=15000
# Analysis and discovery reuse a result until this expires, or until the listing version changes.
AI_CACHE_TTL_MS=600000
AI_RATE_LIMIT_TOKEN=10
# Optional server-side catalog URL. Falls back to REACT_APP_FIREBASE_DATABASE_URL.
FIREBASE_DATABASE_URL=

# Firebase Realtime Database
# Create a project at https://console.firebase.google.com
# Enable Realtime Database and copy your config values here.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
